# Copy to wiki-parser/.env and fill in SURGE_DB_PASSWORD.
# Loaded automatically by config.py via python-dotenv.

SURGE_DB_HOST=192.168.1.21
SURGE_DB_PORT=5432
SURGE_DB_NAME=surge_wiki
SURGE_DB_USER=surge_admin
SURGE_DB_PASSWORD=

# Override these if running the parser on a machine where the dump files
# live at a different path (e.g. sshfs mount of the server).
SURGE_DUMP_PATH=/mnt/data/downloads/enwiki-20260401-pages-articles-multistream.xml.bz2
SURGE_INDEX_PATH=/mnt/data/downloads/enwiki-20260401-pages-articles-multistream-index.txt.bz2
